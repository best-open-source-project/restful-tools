<idea-plugin url="https://www.jetbrains.com/idea">
  <id>com.github.loren.restful.tools</id>
  <name>RestfulTools</name>
  <vendor email="cn.luowenjie@qq.com" url="https://">Loren</vendor>

  <!--suppress PluginXmlValidity -->
  <description><![CDATA[
        <ul>
            <li>
                <b>A set of auxiliary tools for Restful service development</b>
                <ol>
                    <li>Provides a display window of Services tree</li>
                    <li>Double click the URL to jump directly to the corresponding method
                        definition
                    </li>
                    <li>A simple http request tool</li>
                    <li>Support Spring system (Spring MVC / Spring Boot)</li>
                    <li>Support JAX-RS</li>
                    <li>Support `Navigate-> Request Service` search Mapping (Ctrl + Alt + \)</li>
                </ol>
            </li>
            <br>
            <li>
                <b>一套 Restful 服务开发辅助工具集</b>
                <ol>
                    <li>提供了一个 Services tree 的显示窗口</li>
                    <li>双击 URL 直接跳转到对应的方法定义</li>
                    <li>一个简单的 http 请求工具</li>
                    <li>支持 Spring 体系 (Spring MVC / Spring Boot)</li>
                    <li>支持 JAX-RS</li>
                    <li>支持 `Navigate -> Request Service` 搜索 Mapping (Ctrl + Alt + \)</li>
                </ol>
            </li>
        </ul>
        ]]></description>

  <idea-version since-build="252.*"/>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.properties</depends>
  <depends>org.jetbrains.plugins.yaml</depends>
  <depends>org.jetbrains.kotlin</depends>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService
        serviceImplementation="com.github.loren.restful.tools.configuration.RestfulSetting"/>

    <applicationConfigurable parentId="tools"
        instance="com.github.loren.restful.tools.configuration.RestfulSettingConfigurable"
        id="com.github.loren.restful.tools.configuration.RestfulSettingConfigurable"
        dynamic="true"
        bundle="messages.RestfulToolBundle"
        key="setting.configurable.displayName"/>

    <projectService serviceInterface="com.github.loren.restful.tools.service.ToolWindowService"
        serviceImplementation="com.github.loren.restful.tools.service.impl.ToolWindowServiceImpl"/>

    <projectService
        serviceImplementation="com.github.loren.restful.tools.view.search.GotoRequestConfiguration"/>

    <toolWindow id="RestfulTools" anchor="right"
        factoryClass="com.github.loren.restful.tools.view.window.RestfulToolWindowFactory"
        order="last"
        doNotActivateOnStart="true" icon="AllIcons.Webreferences.Openapi"
        canCloseContents="true"
    />

    <projectService serviceInterface="com.github.loren.restful.tools.service.Notify"
        serviceImplementation="com.github.loren.restful.tools.service.impl.NotificationImpl"/>

    <projectService serviceInterface="com.github.loren.restful.tools.service.CacheService"
        serviceImplementation="com.github.loren.restful.tools.service.impl.CacheServiceImpl"/>

    <notificationGroup displayType="BALLOON" id="RestfulTools.Notify" toolWindowId="RestfulTools"/>
  </extensions>

  <actions>
    <action id="Tool.GotoRequestService"
        class="com.github.loren.restful.tools.view.search.GotoRequestAction">
      <add-to-group group-id="GoToTargetEx" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt BACK_SLASH"/>
    </action>

    <action id="RestfulTools.action.OptionForEditor-CurrentClassTree"
        class="com.github.loren.restful.tools.actions.dialog.CurrClassTreeAction">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <group id="RestfulTools.action.OptionForEditors"
        class="com.github.loren.restful.tools.actions.copy.OptionForEditorGroups">
      <add-to-group group-id="EditorPopupMenu" anchor="after"
          relative-to-action="RestfulTools.action.OptionForEditor-CurrentClassTree"/>
      <action id="RestfulTools.action.OptionForEditor-NavigationServiceTreeAction"
          class="com.github.loren.restful.tools.actions.copy.NavigationServiceTreeAction"/>
      <action id="RestfulTools.action.OptionForEditor-CopyApiPath"
          class="com.github.loren.restful.tools.actions.copy.CopyApiAction"/>
      <action id="RestfulTools.action.OptionForEditor-CopyFullPath"
          class="com.github.loren.restful.tools.actions.copy.CopyFullAction"/>
    </group>

    <group id="RestfulTools.Toolbar">

      <action class="com.github.loren.restful.tools.actions.RefreshAction"/>

      <reference ref="Tool.GotoRequestService"/>

      <separator text="Separator"/>

      <action class="com.github.loren.restful.tools.actions.ScanFilterAction"/>

      <action class="com.github.loren.restful.tools.actions.WithLibraryAction"/>

    </group>
  </actions>

</idea-plugin>